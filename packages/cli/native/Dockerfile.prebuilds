FROM --platform=$BUILDPLATFORM node:26.8.1-bookworm@sha256:9f94d34c787165dca03b74e5bf9c3bf90e8de79b19aa3d87fe1fa1694bf75c89 AS node_headers

FROM --platform=$TARGETPLATFORM rockylinux:8@sha256:9794037624aaa6212aeada1d28861ef5e0a935adaf93e4ef79837119f2a2d04c AS linux_gnu
RUN dnf --setopt=install_weak_deps=False -y install \
    gcc-c++-8.5.0-28.el8_10 \
    libstdc++-devel-8.5.0-28.el8_10 \
    binutils-2.30-128.el8_10 \
    glibc-devel-2.28-251.el8_10.40 \
  && dnf clean all
COPY --from=node_headers /usr/local/include/node /opt/node/include/node
COPY native/prism_authoring.cc /src/prism_authoring.cc
RUN mkdir -p /out \
  && LC_ALL=C SOURCE_DATE_EPOCH=0 c++ -std=c++17 -Wall -Wextra -Werror -Wpedantic -O2 -fPIC \
    -fdebug-prefix-map=/src=. -ffile-prefix-map=/src=. -fmacro-prefix-map=/src=. \
    -DNAPI_VERSION=8 -DNODE_GYP_MODULE_NAME=prism_authoring -I /opt/node/include/node \
    -shared -Wl,--build-id=none -o /out/prism_authoring.node /src/prism_authoring.cc \
  && strip --strip-unneeded /out/prism_authoring.node \
  && printf 'compiler=%s\nlinker=%s\nstrip=%s\n' \
    "$(c++ --version | sed -n '1p')" \
    "$(ld --version | sed -n '1p')" \
    "$(strip --version | sed -n '1p')" > /out/toolchain.txt

FROM --platform=$TARGETPLATFORM node:26.8.1-alpine@sha256:2d984a15c9b54fd0aeb608b8e0d0d83529eb34d2966db27a1fb4f1edc3d298a3 AS linux_musl
RUN apk add --no-cache \
    g++=15.2.0-r5 \
    gcc=15.2.0-r5 \
    binutils=2.45.1-r1 \
    musl=1.2.6-r2 \
    musl-dev=1.2.6-r2
COPY native/prism_authoring.cc /src/prism_authoring.cc
RUN mkdir -p /out \
  && LC_ALL=C SOURCE_DATE_EPOCH=0 c++ -std=c++17 -Wall -Wextra -Werror -Wpedantic -O2 -fPIC \
    -fdebug-prefix-map=/src=. -ffile-prefix-map=/src=. -fmacro-prefix-map=/src=. \
    -DNAPI_VERSION=8 -DNODE_GYP_MODULE_NAME=prism_authoring -I /usr/local/include/node \
    -shared -Wl,--build-id=none -o /out/prism_authoring.node /src/prism_authoring.cc \
  && strip --strip-unneeded /out/prism_authoring.node \
  && printf 'compiler=%s\nlinker=%s\nstrip=%s\n' \
    "$(c++ --version | sed -n '1p')" \
    "$(ld --version | sed -n '1p')" \
    "$(strip --version | sed -n '1p')" > /out/toolchain.txt

FROM scratch AS export_linux_gnu
COPY --from=linux_gnu /out/ /

FROM scratch AS export_linux_musl
COPY --from=linux_musl /out/ /
