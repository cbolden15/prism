FROM node@sha256:367679cf9792759492a486e4aa4b421764d71a9546a6dae8aab81a99eb797b3e

LABEL org.pnh.base-image-digest="sha256:367679cf9792759492a486e4aa4b421764d71a9546a6dae8aab81a99eb797b3e"

WORKDIR /runner

COPY package.json package-lock.json ./
COPY package.json /sandbox/package.json
RUN npm ci --ignore-scripts --workspaces=false \
  && install -d node_modules/@useprism \
  && ln -s /sandbox/packages/sdk node_modules/@useprism/sdk \
  && ln -s /sandbox/packages/runtime node_modules/@useprism/runtime

COPY container-entrypoint.mjs sandbox-supervisor.mjs tsx-preload.mjs ./

RUN groupadd --gid 10001 pnh \
  && useradd --uid 10001 --gid 10001 --create-home pnh \
  && install -d --owner pnh --group pnh /coverage \
  && install -d /sandbox \
  && ln -s /runner/node_modules /sandbox/node_modules

USER 10001:10001
