{
  "version": "pnh-plugin-spawn-profile-v1",
  "entrypointFrom": "manifest.entrypoint",
  "cwd": "plugin-root",
  "envAllowlist": ["HOME", "PATH"],
  "environment": {
    "NODE_OPTIONS": "--disable-proto=throw"
