FROM node@sha256:367679cf9792759492a486e4aa4b421764d71a9546a6dae8aab81a99eb797b3e

LABEL org.pnh.base-image-digest="sha256:367679cf9792759492a486e4aa4b421764d71a9546a6dae8aab81a99eb797b3e"

WORKDIR /pnh/kernel/plugin-runner

COPY sdk/ /pnh/node_modules/@useprism/sdk/
COPY runner/entrypoint.mjs ./entrypoint.mjs
COPY plugin/ ./plugin/

RUN groupadd --gid 10101 pnh-plugin \
  && useradd --uid 10101 --gid 10101 --no-create-home pnh-plugin

USER 10101:10101

ENTRYPOINT ["node", "--disallow-code-generation-from-strings", "/pnh/kernel/plugin-runner/entrypoint.mjs"]
